---
import "../styles/sandbox.css";

interface Props {
  title: string;
  active: "home" | "vanilla" | "vue" | "react";
}

const { title, active } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const links = [
  { id: "home", href: base, label: "Overview" },
  { id: "vanilla", href: `${base}vanilla/`, label: "Vanilla (core)" },
  { id: "vue", href: `${base}vue/`, label: "Vue" },
  { id: "react", href: `${base}react/`, label: "React" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{title} · cad-viewer sandbox</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={base}>cad-viewer <span>sandbox</span></a>
      <nav aria-label="Sandbox pages">
        {links.map((link) => <a href={link.href} aria-current={link.id === active ? "page" : undefined}>{link.label}</a>)}
      </nav>
      <a class="repo" href="https://github.com/jesusjbriceno/cad-viewer">GitHub</a>
    </header>
    <slot />
  </body>
</html>
