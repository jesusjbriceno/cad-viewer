---
import { DEFAULT_LOCALE } from "@cadscene/core";
import Base from "../layouts/Base.astro";
import { messages } from "../lib/i18n";

const t = messages(DEFAULT_LOCALE);
---

<Base active="vanilla">
  <div class="app" data-sandbox>
    <aside class="side">
      <section>
        <h2 data-i18n="drawing">{t.drawing}</h2>
        <select data-samples aria-label={t.samples.label} data-i18n-aria="samples.label"></select>
        <div class="row"><input data-file type="file" accept=".dxf,.dwg" aria-label={t.openFile} data-i18n-aria="openFile" /></div>
        <p class="drop-hint" data-i18n="dropHint">{t.dropHint}</p>
        <p class="drop-hint"><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/credits/`} data-i18n="samples.credits">{t.samples.credits}</a></p>
      </section>
      <section>
        <h2 data-i18n="layout">{t.layout}</h2>
        <select data-layouts aria-label={t.layout} data-i18n-aria="layout"></select>
      </section>
      <section>
        <h2 data-i18n="layers">{t.layers}</h2>
        <ul class="layers" data-layers></ul>
        <div class="row">
          <button data-action="show-all" data-i18n="showAll">{t.showAll}</button>
          <button data-action="hide-all" data-i18n="hideAll">{t.hideAll}</button>
        </div>
      </section>
      <section>
        <h2 data-i18n="info.title">{t.info.title}</h2>
        <pre class="info" data-summary></pre>
        <pre class="info" data-properties></pre>
      </section>
      <section>
        <h2 data-i18n="selection">{t.selection}</h2>
        <pre class="info" data-selection></pre>
      </section>
      <section>
        <h2 data-i18n="measure">{t.measure}</h2>
        <pre class="info" data-measure></pre>
      </section>
    </aside>
    <main class="stage">
      <div class="toolbar" role="toolbar" aria-label={t.toolbar} data-i18n-aria="toolbar">
        <button data-action="fit" title={t.fitTitle} data-i18n-title="fitTitle" data-i18n="fit">{t.fit}</button>
        <button data-action="zoom-in" title={t.zoomInTitle} data-i18n-title="zoomInTitle">+</button>
        <button data-action="zoom-out" title={t.zoomOutTitle} data-i18n-title="zoomOutTitle">−</button>
        <button data-tool="pan" data-i18n="tools.pan">{t.tools.pan}</button>
        <button data-tool="zoom-window" data-i18n="tools.zoom-window">{t.tools["zoom-window"]}</button>
        <button data-tool="measure" data-i18n="tools.measure">{t.tools.measure}</button>
        <span class="spacer"></span>
        <button data-action="theme" data-i18n="theme">{t.theme}</button>
        <button data-action="png" data-i18n="exportPng">{t.exportPng}</button>
      </div>
      <div class="viewer-host" role="region" aria-label={t.dropRegion} data-i18n-aria="dropRegion"></div>
      <div class="status" role="status">{t.ready}</div>
    </main>
  </div>
</Base>

<script>
  import { mountVanillaSandbox } from "../components/vanilla";

  const root = document.querySelector<HTMLElement>("[data-sandbox]");
  // Sandbox convenience: the viewer is reachable from the browser console
  // (`viewer.getSummary()`, `viewer.getEntities()`, `viewer.getParts()`).
  if (root) Object.assign(window, { viewer: mountVanillaSandbox(root) });
</script>
