{
  "name": "cad-viewer-monorepo",
  "private": true,
  "type": "module",
  "description": "View-only 2D CAD viewer (DWG/DXF) for the web, with Vue and React components.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter ./packages/** run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "pnpm --filter sandbox dev",
    "sandbox:build": "pnpm --filter sandbox build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "happy-dom": "^21.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
