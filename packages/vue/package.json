{
  "name": "@jesusjbriceno/cad-viewer-vue",
  "version": "0.2.0",
  "description": "Vue 3 component for the view-only CAD viewer (DWG/DXF).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@jesusjbriceno/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./3d": {
      "@jesusjbriceno/source": "./src/3d.ts",
      "types": "./dist/3d.d.ts",
      "import": "./dist/3d.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesusjbriceno/cad-viewer.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/jesusjbriceno/cad-viewer#readme",
  "bugs": "https://github.com/jesusjbriceno/cad-viewer/issues",
  "keywords": [
    "cad",
    "dwg",
    "dxf",
    "viewer",
    "canvas",
    "vue",
    "3d",
    "stl",
    "obj"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./3d": {
        "types": "./dist/3d.d.ts",
        "import": "./dist/3d.js"
      }
    }
  },
  "dependencies": {
    "@jesusjbriceno/cad-viewer-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@jesusjbriceno/cad-viewer-3d": "workspace:^",
    "three": ">=0.170.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@jesusjbriceno/cad-viewer-3d": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "vue": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "@jesusjbriceno/cad-viewer-3d": "workspace:*",
    "three": "^0.186.1"
  }
}
